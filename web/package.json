{
  "name": "kone-web",
  "version": "0.4.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --host 127.0.0.1",
    "build": "bun run typecheck && bunx --bun vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --deny-warnings",
    "fmt": "oxfmt \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,tsx,mjs}\" \"e2e/**/*.{ts,mjs}\" *.json *.ts *.js *.html",
    "fmt:check": "oxfmt --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,tsx,mjs}\" \"e2e/**/*.{ts,mjs}\" *.json *.ts *.js *.html",
    "test": "bun test test/core.test.ts test/components.test.tsx && node --test test/native.test.mjs test/real-results.test.mjs",
    "test:e2e": "playwright test",
    "preview": "bunx --bun vite preview --host 127.0.0.1",
    "test:build": "node --test test/build.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "i18next": "26.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "happy-dom": "21.0.4",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "packageManager": "bun@1.4.4"
}
