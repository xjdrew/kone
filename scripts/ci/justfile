# Comprehensive CI, native acceptance and advanced maintenance tasks.
set minimum-version := '1.59.0'
set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

source_root := env('JUST_WORKING_DIRECTORY', justfile_directory())

[working-directory(source_root)]
default:
    @just --justfile "$KONE_TASK_ROOT/justfile" --list ci

[group('Go, builds and quality')]
[script('bash', '-euo', 'pipefail')]
[working-directory(source_root)]
fmt *args:
    source "$KONE_TASK_ROOT/scripts/ci/task-help.sh"
    task_arguments fmt "$@"
    if [[ "$TASK_HELP" == true ]]; then exit 0; fi
    if (( TASK_ARG_COUNT )); then set -- "${TASK_ARGS[@]}"; else set --; fi
    gofmt -w cmd pkg test web/embed.go

[group('Go, builds and quality')]
[script('bash', '-euo', 'pipefail')]
[working-directory(source_root)]
check-config *args:
    source "$KONE_TASK_ROOT/scripts/ci/task-help.sh"
    task_arguments check-config "$@"
    if [[ "$TASK_HELP" == true ]]; then exit 0; fi
    if (( TASK_ARG_COUNT )); then set -- "${TASK_ARGS[@]}"; else set --; fi
    entry=./cmd/kone
    if [[ -d cmd/kone-cli ]]; then entry=./cmd/kone-cli; fi
    go run -tags with_gvisor "$entry" -check -config "$1"

